{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/nemotron-3-ultra-free",
  "default_agent": "implementer",
  "share": "disabled",
  "autoupdate": "notify",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "swift build*": "allow",
      "swift test*": "allow",
      "swift run*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "python3 scripts/build-index.py*": "allow",
      "python3 scripts/review-tier.py*": "allow",
      "git push*": "deny",
      "rm -rf*": "deny"
    },
    "webfetch": "ask",
    "skill": {
      "*": "allow"
    }
  }
}
